{
  "name": "nexus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node src/control/dashboard/build.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test --test-timeout=600000 'src/**/!(slice|template-slice).test.{ts,js}'",
    "test:slice": "node --test --test-concurrency=1 --test-timeout=600000 src/slice.test.ts src/template-slice.test.ts",
    "test:harness": "node --test --test-timeout=600000 src/harness/slice.test.ts",
    "probe": "node src/probe/main.ts"
  },
  "devDependencies": {
    "@pierre/diffs": "1.6.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "esbuild": "0.28.2",
    "shiki": "4.5.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/gondolin": "0.13.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@earendil-works/pi-env": "1.4.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
