#!/bin/bash
# Stand-in for systemctl in a machine that cannot boot systemd. It runs a unit's ExecStart as its User and Group,
# with its WorkingDirectory, UMask and Environment, drop-ins included, in a session of its own, and logs to
# /var/log/standin-journal/<unit>.log. It honours no sandboxing, restart policy or dependency, and a timer never fires.
set -euo pipefail

state=/run/standin-systemd
logs=/var/log/standin-journal
mkdir -p "$state" "$logs"

unit_name() { case $1 in *.service|*.timer) echo "$1" ;; *) echo "$1.service" ;; esac; }
unit_file() {
  local dir
  for dir in /etc/systemd/system /lib/systemd/system; do [ -e "$dir/$1" ] && { echo "$dir/$1"; return; }; done
  echo "systemctl: Unit $1 not found." >&2
  return 5
}
# Each value of a [Service] key in the unit and then its drop-ins, one per line, in the order systemd reads them.
values() {
  local file=$1 key=$2 f
  for f in "$file" /etc/systemd/system/"$(basename "$file")".d/*.conf; do
    [ -e "$f" ] || continue
    sed -n "s/^$key=//p" "$f"
  done
}
last() { values "$1" "$2" | tail -n 1; }
environment() { values "$1" Environment | tr ' ' '\n' | sed '/^$/d'; }

pid_of() { cat "$state/$1.pid" 2>/dev/null || echo 0; }
active() {
  local unit=$1 pid
  case $unit in *.timer) [ -e "$state/$unit.active" ]; return ;; esac
  pid=$(pid_of "$unit")
  [ "$pid" != 0 ] && [ -d "/proc/$pid" ] && ! grep -q '^State:.*Z' "/proc/$pid/status"
}

start() {
  local unit=$1 file user group dir umask exec
  file=$(unit_file "$unit")
  case $unit in *.timer) touch "$state/$unit.active"; return ;; esac
  active "$unit" && return
  user=$(last "$file" User); user=${user:-root}
  group=$(last "$file" Group); group=${group:-$(id -gn "$user")}
  dir=$(last "$file" WorkingDirectory); dir=${dir:-/}
  umask=$(last "$file" UMask); umask=${umask:-0022}
  exec=$(last "$file" ExecStart)
  mapfile -t env < <(environment "$file")
  home=$(getent passwd "$user" | cut -d: -f6)
  (
    # systemd starts a service with only stdin, stdout and stderr open, so it holds none of its caller's locks.
    for fd in /proc/$BASHPID/fd/*; do fd=${fd##*/}; if [ "$fd" -gt 2 ]; then eval "exec $fd>&-"; fi; done
    exec setsid setpriv --reuid="$user" --regid="$group" --init-groups \
      env -i "HOME=$home" "USER=$user" "${env[@]}" \
      sh -c 'cd "$1" && umask "$2" && shift 2 && exec "$@"' sh "$dir" "$umask" $exec
  ) >>"$logs/$unit.log" 2>&1 </dev/null &
  echo $! > "$state/$unit.pid"
  if [ "$(last "$file" Type)" = oneshot ]; then wait $! || return 1; fi
}

stop() {
  local unit=$1 pid i
  rm -f "$state/$unit.active"
  pid=$(pid_of "$unit")
  if active "$unit"; then
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid"
    for i in $(seq 300); do active "$unit" || break; sleep 0.1; done
    if active "$unit"; then kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid"; fi
  fi
  rm -f "$state/$unit.pid"
}

[ "${1:-}" = --quiet ] && shift
command=${1:-}
shift || true
quiet=0 now=0 units=()
for arg in "$@"; do
  case $arg in
    --quiet|-q) quiet=1 ;;
    --now) now=1 ;;
    --no-pager|--no-block) ;;
    --property=*|--value) ;;
    *) units+=("$(unit_name "$arg")") ;;
  esac
done

case $command in
  daemon-reload) ;;
  enable) for u in "${units[@]}"; do unit_file "$u" >/dev/null; [ "$now" = 0 ] || start "$u"; done ;;
  disable) for u in "${units[@]}"; do [ "$now" = 0 ] || stop "$u"; done ;;
  start) for u in "${units[@]}"; do start "$u"; done ;;
  stop) for u in "${units[@]}"; do stop "$u"; done ;;
  restart) for u in "${units[@]}"; do stop "$u"; start "$u"; done ;;
  try-restart) for u in "${units[@]}"; do if active "$u"; then stop "$u"; start "$u"; fi; done ;;
  is-active)
    for u in "${units[@]}"; do
      if active "$u"; then [ "$quiet" = 1 ] || echo active; else [ "$quiet" = 1 ] || echo inactive; exit 3; fi
    done ;;
  show)
    property=$(printf '%s\n' "$@" | sed -n 's/^--property=//p')
    u=${units[0]}
    case $property in
      MainPID) if active "$u"; then pid_of "$u"; else echo 0; fi ;;
      Environment) environment "$(unit_file "$u")" | paste -sd' ' ;;
      *) echo "systemctl: the stand-in does not show $property" >&2; exit 1 ;;
    esac ;;
  *) echo "systemctl: the stand-in does not know $command" >&2; exit 1 ;;
esac
