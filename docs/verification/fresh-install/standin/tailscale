#!/bin/bash
# Stand-in for the tailscale CLI. `status --json` prints the tailnet the test made up, while the tailscaled unit
# runs. `up`, `set` and `serve` change nothing.
set -euo pipefail
running() { systemctl is-active --quiet tailscaled; }
case "$*" in
  "status --json")
    running || { echo "failed to connect to local tailscaled; it doesn't appear to be running" >&2; exit 1; }
    cat /etc/standin-tailscale/status.json ;;
  "serve status --json") echo '{}' ;;
  up|"up "*|set\ *|serve\ *) ;;
  *) echo "tailscale: the stand-in does not know: tailscale $*" >&2; exit 1 ;;
esac
