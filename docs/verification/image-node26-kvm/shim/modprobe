#!/bin/sh
# Stands in for kmod's `modprobe --show-depends <module>` on a pylon built without kmod: prints an insmod line for each
# dependency modules.dep lists, deepest first, then the module.
set -eu
[ "$1" = --show-depends ] || { echo "shim modprobe takes only --show-depends" >&2; exit 64; }
tree=/lib/modules/$(uname -r)
line=$(grep -E "/$(echo "$2" | sed 's/[-_]/[-_]/g')\.ko\.gz:" "$tree/modules.dep" | head -n 1)
[ -n "$line" ] || { echo "modprobe: FATAL: Module $2 not found in directory $tree" >&2; exit 1; }
for dep in $(echo "$line" | cut -d: -f2 | tr ' ' '\n' | tac) $(echo "$line" | cut -d: -f1); do
  echo "insmod $tree/$dep "
done
