# The Nexus control plane. deploy/install-control.sh installs this file as /etc/systemd/system/nexus-control.service.
#
# It runs as the system user `nexus-control`, apart from the probe's `nexus` user when both run on one machine:
# the control plane holds the harness's model login, and the probe answers every tailnet caller. Its state is
# /var/lib/nexus-control (its home): the registry, the harness's storage and the model login.
#
# The harness runs one bridge process per busy pylon (src/control/harness/bridge.ts). The default KillMode stops them
# with the control plane, which ends each pylon's pi-env daemon and every command it started. After a restart,
# a tool call that was running reports `interrupted` to the model.

[Unit]
Description=Nexus control plane (registry, reconcile loop, agent harness and API)
Wants=network-online.target
After=network-online.target tailscaled.service
# Preparing a release only enables the backup's timer, so the restart that follows starts it.
Wants=nexus-backup.timer

[Service]
Type=simple
User=nexus-control
Group=nexus-control
WorkingDirectory=/var/lib/nexus-control
# The bridges start as this Node, so Node 26 must be in one of these directories.
Environment=PATH=/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env node /opt/nexus/control-current/src/control/main.ts /etc/nexus/control.json
TimeoutStopSec=30
# The listen address exists only once tailscaled is up, so an early start fails and is retried.
Restart=on-failure
RestartSec=5
# A share of the node that its other work cannot take. Under contention the control plane gets ten times the CPU
# weight of any other service, the probe with its pylons' VMs among them. 1 GiB of its memory is never reclaimed or
# swapped out: it peaked at 780 MiB on 2026-11-15. The kernel's OOM killer picks a pylon's VM before it.
# This guards against the node's other work only. It does nothing when the control plane's own main thread is
# busy, as on 2026-11-15, when the node was 90 % idle.
CPUWeight=1000
MemoryMin=1G
OOMScoreAdjust=-500
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nexus-control
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
