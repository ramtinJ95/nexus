#!/usr/bin/env bash
# The live box of docs/multiplayer-plan.md's mp-03: on the stack started with people, alice an admin and bob an engineer,
# bob's `nexus send`, `nexus attach` and `nexus archive` on alice's thread are each refused with a 403 that names alice,
# alice's own send passes access to her pylon, her thread stays active, and alice archives bob's thread. Each thread is a
# Claude worker, as a shared install's must be since mp-16, and this stack's image has no Claude Code, so no message
# reaches a conversation here.
# Exits 0 only if every step did what it should.
set -euo pipefail
V="$(cd "$(dirname "$0")" && pwd)/verify-nexus"
fail() { echo "owner check: $*" >&2; exit 1; }

trap '"$V" down >&2 || true' EXIT
NEXUS_VERIFY_PEOPLE=1 "$V" up
"$V" doctor
evidence=$("$V" evidence)

# A shared install boots a pylon only with its owner's own logins, so each person signs in with made-up tokens first.
printf '%s\n' "sk-ant-oat01-alice-made-up-$(date +%s)" | "$V" cli owner-login-claude-alice -- login claude >/dev/null
printf '%s\n' "ghp_verifyalice0$(date +%s)" | "$V" cli owner-login-github-alice -- login github >/dev/null
printf '%s\n' "sk-ant-oat01-bob-made-up-$(date +%s)" | "$V" cli owner-login-claude-bob --as bob -- login claude >/dev/null
printf '%s\n' "ghp_verifybob0$(date +%s)" | "$V" cli owner-login-github-bob --as bob -- login github >/dev/null
T=$("$V" cli owner-start-alice -- start --project spoon --claude "owner: alice's" --json | jq -r .id)
B=$("$V" cli owner-start-bob --as bob -- start --project spoon --claude "owner: bob's" --json | jq -r .id)
echo "alice started $T, bob started $B"
# A shared install's thread runs Claude Code, which this stack's image does not hold, so alice's send passes access and
# fails in her pylon, where the probe cannot start Claude.
code=0
"$V" cli owner-send-alice -- send "$T" "alice was here" --json </dev/null >/dev/null 2>&1 || code=$?
said=$(cat "$(ls "$evidence"/*-owner-send-alice.stderr | tail -1)")
echo "alice nexus send: exit $code $(grep -o '{"error".*}' <<< "$said" | tail -1)"
if grep -q '"status":403' <<< "$said"; then fail "alice's own send was refused"; fi
grep -q 'claude: not found' <<< "$said" || fail "alice's own send did not reach her pylon's Claude Code"

# A refused CLI call exits 3 and puts {"error","kind","status","code"} on stderr, which the driver records, or on the
# pty's one stream for attach, which needs a terminal.
refused() {
  local step=$1 tty=$2; shift 2
  local code=0
  "$V" cli "$step" --as bob $tty -- "$@" --json </dev/null >/dev/null 2>&1 || code=$?
  local said
  said=$(cat "$(ls "$evidence"/*-"$step".stdout | tail -1)" "$(ls "$evidence"/*-"$step".stderr | tail -1)" | tr -d '\r' | grep -o '{"error".*}' | tail -1)
  echo "bob nexus $1: exit $code $said"
  [ "$code" = 3 ] || fail "bob's nexus $1 exited $code, not 3"
  jq -e '.status == 403' <<< "$said" >/dev/null || fail "bob's nexus $1 was not a 403"
  grep -q "is alice@example.com's" <<< "$said" || fail "bob's nexus $1 refusal does not name alice"
}
refused owner-send-bob "" send "$T" "bob was here"
refused owner-attach-bob --tty attach "$T"
refused owner-archive-bob "" archive "$T"

status=$("$V" cli owner-show-after -- show "$T" --json | jq -r .thread.status)
echo "alice's $T after bob's refusals: status $status"
[ "$status" = active ] || fail "alice's thread is $status"

archived=$("$V" cli owner-archive-admin -- archive "$B" --json | jq -r .status)
echo "alice, an admin, archived bob's $B: $archived"
[ "$archived" = archived ] || fail "the admin's archive of bob's thread left it $archived"
echo "owner check: alice's send reached her pylon, bob was refused send, attach and archive on it with alice named, it did not change, and alice archived bob's thread as an admin"
