#!/usr/bin/env bash
# The live box of docs/multiplayer-plan.md's mp-02: on the stack started with people, alice an admin and bob an engineer,
# alice starts a thread, bob's `nexus show` names alice as its owner, and the node's identity is refused on a person route.
# Exits 0 only if every step did what it should.
set -euo pipefail
V="$(cd "$(dirname "$0")" && pwd)/verify-nexus"
base="$(cd "$(dirname "$0")/../../../.." && pwd)/.verify/nexus"
refused=$(mktemp)
fail() { echo "people check: $*" >&2; exit 1; }

trap '"$V" down >&2 || true; rm -f "$refused"' EXIT
NEXUS_VERIFY_PEOPLE=1 "$V" up
"$V" doctor
run=$(cat "$base/current")
state() { node -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))[process.argv[2]])' "$base/runs/$run/state.json" "$1"; }
api=$(state api) bobApi=$(state bobApi) nodeApi=$(state nodeApi)

whoami() { curl -fsS "$1/v1/whoami" | jq -c '{node, person, deployer}'; }
echo "alice: $(whoami "$api")"
echo "bob:   $(whoami "$bobApi")"
echo "node:  $(whoami "$nodeApi")"
[ "$(whoami "$api")" = '{"node":"nALICE","person":true,"deployer":true}' ] || fail "alice is not an admin person"
[ "$(whoami "$bobApi")" = '{"node":"nBOB","person":true,"deployer":false}' ] || fail "bob is not an engineer person"

# A shared install boots a pylon only with its owner's own logins, so each person signs in with made-up tokens first.
printf '%s\n' "sk-ant-oat01-alice-made-up-$(date +%s)" | "$V" cli people-login-claude-alice -- login claude >/dev/null
printf '%s\n' "ghp_verifyalice0$(date +%s)" | "$V" cli people-login-github-alice -- login github >/dev/null
T=$("$V" cli people-start -- start --project spoon --claude "people: alice's" --json | jq -r .id)
owner=$("$V" cli people-show-bob --as bob -- show "$T" --json | jq -r .thread.owner)
echo "bob's nexus show $T names owner $owner"
[ "$owner" = alice@example.com ] || fail "bob's show names $owner as the owner of alice's thread"

code=$(curl -sS -o "$refused" -w '%{http_code}' -X POST -H 'content-type: application/json' --data '{"project":"spoon","title":"node"}' "$nodeApi/v1/threads")
echo "node POST /v1/threads: $code $(cat "$refused")"
[ "$code" = 403 ] || fail "the node's POST /v1/threads got $code"
echo "people check: alice started $T, bob reads alice as its owner, and the node's identity got 403 on a person route"
