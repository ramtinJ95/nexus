#!/usr/bin/env bash
# The live box of docs/multiplayer-plan.md's mp-05: on the stack started with people, alice an admin and bob an engineer,
# bob's `nexus project edit` of spoon is refused with a 403 that says only an admin may edit a project, his
# `nexus project show` reads spoon as it was before, and alice's own edit of spoon succeeds.
# Exits 0 only if every step did what it should.
set -euo pipefail
V="$(cd "$(dirname "$0")" && pwd)/verify-nexus"
fail() { echo "project check: $*" >&2; exit 1; }

trap '"$V" down >&2 || true' EXIT
NEXUS_VERIFY_PEOPLE=1 "$V" up
"$V" doctor
evidence=$("$V" evidence)

before=$("$V" cli project-show-before --as bob -- project show spoon --json)
echo "bob reads spoon: $(jq -c '{id, defaultBranch, defaultNode, gitIdentity}' <<< "$before")"

code=0
"$V" cli project-edit-bob --as bob -- project edit spoon --git-name "Bob Was Here" --git-email bob@example.com --json </dev/null >/dev/null 2>&1 || code=$?
said=$(grep -ho '{"error".*}' "$(ls "$evidence"/*-project-edit-bob.stderr | tail -1)" | tail -1)
echo "bob nexus project edit spoon: exit $code $said"
[ "$code" = 3 ] || fail "bob's nexus project edit exited $code, not 3"
jq -e '.status == 403' <<< "$said" >/dev/null || fail "bob's nexus project edit was not a 403"
jq -e '.error == "caller may not edit a project: only an admin may"' <<< "$said" >/dev/null || fail "bob's refusal does not say only an admin may edit a project"

after=$("$V" cli project-show-after --as bob -- project show spoon --json)
[ "$after" = "$before" ] || fail "spoon changed after bob's refused edit: $(diff <(jq -S . <<< "$before") <(jq -S . <<< "$after") || true)"
echo "bob's nexus project show spoon is unchanged after his refused edit"

name=$("$V" cli project-edit-alice -- project edit spoon --git-name "Alice Was Here" --git-email alice@example.com --json | jq -r .gitIdentity.name)
echo "alice, an admin, edited spoon: git name $name"
[ "$name" = "Alice Was Here" ] || fail "alice's edit left spoon's git name $name"
echo "project check: bob was refused nexus project edit with only an admin named, spoon did not change, and alice edited it as an admin"
