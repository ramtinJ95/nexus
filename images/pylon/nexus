#!/usr/bin/env node
// The in-pylon nexus CLI. Each command is one POST of a PylonApiRequest (src/probe/pylon-api.ts) to NEXUS_API's request
// path, which the host bridge answers from the probe on this node, so the call never leaves the machine and carries no
// token. --json prints the probe's reply as it is. Plain JavaScript that imports only Node and the contract beside it,
// run by the image's Node.
import { resolve } from "node:path";
import { parseArgs } from "node:util";
import { bridgeRequestPath, maxEventMessageLength, maxSessionLength, nexusApi, sessionKinds } from "./nexus-contract.ts";

const version = "0.4.0";
const api = process.env.NEXUS_API || nexusApi;

/** Each command family's lines of `nexus --help`, which `nexus <family> --help` prints alone. */
const help = {
  event: [
    "  nexus event <kind> [--session ID] [--message TEXT]",
    `                      <kind> is one of ${sessionKinds.join(", ")}`,
  ],
  info: ["  nexus info                                     this pylon's thread, project, node, hosts and previews"],
  services: [
    "  nexus services [list]                          list services and their preview URLs",
    "  nexus services ensure                          start what .nexus/services.yaml declares, wait for health and preview URLs",
    "  nexus services restart|stop [name]",
  ],
  service: [
    "  nexus service logs <name> [--lines N]",
    "  nexus service restart|stop <name>",
    "  nexus service start <name> --command CMD [--port N] [--cwd DIR] [--health PATH|process]",
    "                      [--env NAME=VALUE]... [--preview] [--title T] [--description D] [--timeout-ms N]",
  ],
  preview: [
    "  nexus preview <port> [--title T] [--wait]      publish a port that is already listening, and print its URL",
    "                                                 --wait keeps asking for up to 120 seconds until it has one",
  ],
  unpreview: ["  nexus unpreview <port>                         stop publishing a port that preview published"],
  output: [
    "  nexus output add file <path> [--title T]       declare a file as an output of this thread",
    "  nexus output add diff [--title T]              snapshot the working tree as a diff output",
    "  nexus output list",
  ],
};
const families = Object.keys(help);
const footer = "Every command takes --json, which prints the reply as JSON, and an error as one JSON line on stderr.\n";
const usage = `nexus ${version}, the Nexus pylon CLI

${Object.values(help).flat().join("\n")}
  nexus --version

${footer}`;
const familyHelp = (family) => `${help[family].join("\n")}\n\n${footer}`;
const unknown = `This is the pylon's nexus CLI, which talks to this pylon's node. The person's nexus CLI, which docs/cli.md describes, runs on their machine and is not here. This one offers ${families.join(", ")}`;

class UsageError extends Error {
  constructor(message, family) {
    super(message);
    this.family = family;
  }
}

function int(value, name) {
  const n = Number(value);
  if (!Number.isInteger(n)) throw new UsageError(`${name} must be a whole number, got ${value}`);
  return n;
}

const pending = (name) => `no preview URL for ${name} yet. Nexus publishes it once the control plane assigns a port, and \`nexus services list\` shows it then`;

function printServices({ services }) {
  if (services.length === 0) return "No services.";
  const notes = services.filter((s) => s.wantsPreview && s.url === null).map((s) => pending(s.name));
  for (const note of notes) console.error(`nexus: ${note}`);
  return services.map((s) => [s.name, s.state, String(s.port), s.url ?? "-"].join("\t")).join("\n");
}

function printOutput(o) {
  const what = o.kind === "file" ? o.path : `diff against ${o.base.slice(0, 12)}`;
  return [o.id, o.kind, what, o.title ?? ""].join("\t").trimEnd();
}

const serviceOp = (action) => ({ args: 1, request: ([name]) => ({ op: "services", action, name }), print: printServices });

/** Keyed by the command's words. The longest key that the arguments start with wins. */
const commands = {
  event: {
    args: 1,
    options: { session: { type: "string" }, message: { type: "string" }, at: { type: "string" } },
    request([kind], { session, message, at }) {
      const time = at === undefined ? Date.now() : Number(at);
      if (!Number.isSafeInteger(time) || time < 0) throw new UsageError("--at must be a nonnegative Unix millisecond timestamp");
      if (!sessionKinds.includes(kind)) throw new UsageError(`not a pylon event kind: ${kind}. The kinds are ${sessionKinds.join(", ")}`);
      if (session !== undefined && (session.length === 0 || session.length > maxSessionLength)) throw new UsageError(`session must be 1 to ${maxSessionLength} characters`);
      if (message !== undefined && message.length > maxEventMessageLength) throw new UsageError(`message exceeds ${maxEventMessageLength} characters`);
      return { op: "event", kind, at: time, ...(session === undefined ? {} : { session }), ...(message === undefined ? {} : { message }) };
    },
    print: () => "Event accepted.",
  },
  info: {
    args: 0,
    request: () => ({ op: "info" }),
    print: (i) => [
      `Pylon: ${i.pylonId}`, `Thread: ${i.threadId}`, `Project: ${i.project}`, `Node: ${i.node}`, `API: ${i.api}`,
      `Allowed hosts: ${i.allowedHosts.join(", ") || "none"}`,
      `Logins: ${i.logins.join(", ") || "none"}`,
      i.previews.length === 0 ? "Previews: none" : `Previews:\n${i.previews.map((p) => `  ${p.service}: ${p.url}`).join("\n")}`,
    ].join("\n"),
  },
  services: { args: 0, request: () => ({ op: "services", action: "list" }), print: printServices },
  service: { args: 0, request: () => ({ op: "services", action: "list" }), print: printServices },
  "services ensure": { args: 0, request: () => ({ op: "services", action: "ensure" }), print: printServices },
  "services list": { args: 0, request: () => ({ op: "services", action: "list" }), print: printServices },
  "services restart": { args: [0, 1], request: ([name]) => ({ op: "services", action: "restart", ...(name === undefined ? {} : { name }) }), print: printServices },
  "services stop": { args: [0, 1], request: ([name]) => ({ op: "services", action: "stop", ...(name === undefined ? {} : { name }) }), print: printServices },
  "service restart": serviceOp("restart"),
  "service stop": serviceOp("stop"),
  "service logs": {
    args: 1,
    options: { lines: { type: "string" } },
    request: ([name], { lines }) => ({ op: "service-logs", name, lines: lines === undefined ? 100 : int(lines, "--lines") }),
    print: ({ logs }) => logs.replace(/\n$/, ""),
  },
  "service start": {
    args: 1,
    options: {
      command: { type: "string" }, port: { type: "string" }, cwd: { type: "string" }, health: { type: "string" },
      env: { type: "string", multiple: true }, preview: { type: "boolean" }, title: { type: "string" },
      description: { type: "string" }, "timeout-ms": { type: "string" },
    },
    request([name], v) {
      if (v.command === undefined) throw new UsageError("service start needs --command");
      const env = Object.fromEntries((v.env ?? []).map((pair) => {
        const at = pair.indexOf("=");
        if (at <= 0) throw new UsageError(`--env takes NAME=VALUE, got ${pair}`);
        return [pair.slice(0, at), pair.slice(at + 1)];
      }));
      const shown = { ...(v.title === undefined ? {} : { title: v.title }), ...(v.description === undefined ? {} : { description: v.description }) };
      const decl = {
        command: v.command,
        ...(v.cwd === undefined ? {} : { cwd: v.cwd }),
        ...(v.port === undefined ? {} : { port: int(v.port, "--port") }),
        ...(Object.keys(env).length === 0 ? {} : { env }),
        ...(v.health === undefined ? {} : { health: v.health }),
        ...(Object.keys(shown).length > 0 ? { preview: shown } : v.preview ? { preview: true } : {}),
        ...(v["timeout-ms"] === undefined ? {} : { timeoutMs: int(v["timeout-ms"], "--timeout-ms") }),
      };
      return { op: "service-start", name, decl };
    },
    print: printServices,
  },
  preview: {
    args: 1,
    options: { title: { type: "string" }, wait: { type: "boolean" } },
    /** With --wait, the request is sent again until a reply passes this. */
    settled: (r) => r.url !== null,
    request: ([port], { title }) => ({ op: "preview", port: int(port, "the port"), ...(title === undefined ? {} : { title }) }),
    print: (r) => r.url,
  },
  unpreview: {
    args: 1,
    request: ([port]) => ({ op: "unpreview", port: int(port, "the port") }),
    print: (r) => `Unpublished port ${r.port}. Its URL stops once Nexus publishes the previews without it, within seconds`,
  },
  "output add file": {
    args: 1,
    options: { title: { type: "string" } },
    // Resolved here, because the probe does not know this shell's working directory.
    request: ([path], { title }) => ({ op: "output-add", output: { kind: "file", path: resolve(path), ...(title === undefined ? {} : { title }) } }),
    print: ({ output }) => `Declared ${printOutput(output)}`,
  },
  "output add diff": {
    args: 0,
    options: { title: { type: "string" } },
    request: (_, { title }) => ({ op: "output-add", output: { kind: "diff", ...(title === undefined ? {} : { title }) } }),
    print: ({ output }) => `Declared ${printOutput(output)}`,
  },
  "output list": {
    args: 0,
    request: () => ({ op: "output-list" }),
    print: ({ outputs }) => outputs.length === 0 ? "No declared outputs." : outputs.map(printOutput).join("\n"),
  },
};

function parse(argv) {
  const key = Object.keys(commands)
    .filter((k) => k.split(" ").every((word, i) => argv[i] === word))
    .sort((a, b) => b.length - a.length)[0];
  if (key === undefined) {
    if (argv.length === 0) throw new UsageError("no command given");
    if (families.includes(argv[0])) throw new UsageError(`unknown command: ${argv.join(" ")}`, argv[0]);
    throw new UsageError(`unknown command: ${argv.join(" ")}. ${unknown}`);
  }
  const command = commands[key];
  const family = key.split(" ")[0];
  let parsed;
  try {
    parsed = parseArgs({ args: argv.slice(key.split(" ").length), options: { ...command.options, json: { type: "boolean" } }, allowPositionals: true, strict: true });
  } catch (err) {
    throw new UsageError(err.message, family);
  }
  const [min, max] = Array.isArray(command.args) ? command.args : [command.args, command.args];
  const { positionals, values } = parsed;
  if (positionals.length < min || positionals.length > max) throw new UsageError(`${key} takes ${min === max ? min : `${min} to ${max}`} argument${max === 1 ? "" : "s"}, got ${positionals.length}`, family);
  try {
    return { command, request: command.request(positionals, values), wait: values.wait === true };
  } catch (err) {
    if (err instanceof UsageError) err.family = family;
    throw err;
  }
}

/** One reply of the probe, or the failure's message and HTTP status, null when there was no reply. */
async function send(request) {
  let res;
  try {
    res = await fetch(`${api}${bridgeRequestPath}`, { method: "POST", signal: AbortSignal.timeout(request.op === "event" ? 1500 : 120_000), headers: { "content-type": "application/json" }, body: JSON.stringify(request) });
  } catch (err) {
    return { error: `cannot reach ${api}: ${err.cause?.message ?? err.message}`, status: null };
  }
  const body = await res.text();
  if (res.status !== 200) return { error: body.trimEnd() || `HTTP ${res.status}`, status: res.status };
  try {
    return { reply: JSON.parse(body) };
  } catch {
    return { error: `the probe answered 200 with a body that is not JSON: ${body.slice(0, 200)}`, status: 200 };
  }
}

const waitMs = 120_000;

async function main(argv) {
  const json = argv.includes("--json");
  const fail = (error, status, code) => {
    process.stderr.write(json ? `${JSON.stringify({ error, status })}\n` : `nexus: ${error}\n`);
    return code;
  };
  if (argv[0] === "--version" || argv[0] === "version") {
    console.log(`nexus ${version}`);
    return 0;
  }
  const asked = argv[0] === "help" ? argv.slice(1) : argv.includes("--help") || argv.includes("-h") ? argv : null;
  if (asked !== null) {
    if (asked.length === 0 || asked[0].startsWith("-")) process.stdout.write(usage);
    else if (families.includes(asked[0])) process.stdout.write(familyHelp(asked[0]));
    else return fail(`unknown command: ${asked[0]}. ${unknown}. Run nexus --help for usage`, null, 64);
    return 0;
  }
  let call;
  try {
    call = parse(argv);
  } catch (err) {
    if (!(err instanceof UsageError)) throw err;
    if (argv.length === 0 && !json) {
      process.stderr.write(usage);
      return 64;
    }
    if (json || err.family === undefined) return fail(`${err.message}. Run nexus --help for usage`, null, 64);
    process.stderr.write(`nexus: ${err.message}. Run nexus --help for usage\n\n${familyHelp(err.family)}`);
    return 64;
  }
  const deadline = Date.now() + waitMs;
  let answer = await send(call.request);
  while (call.wait && answer.reply !== undefined && !call.command.settled(answer.reply) && Date.now() < deadline) {
    await new Promise((resolve) => setTimeout(resolve, 1000));
    answer = await send(call.request);
  }
  if (answer.reply === undefined) return fail(answer.error, answer.status, 1);
  const { reply } = answer;
  if (call.command.settled?.(reply) === false && (call.wait || !json)) {
    const why = call.wait ? `no preview URL for ${reply.service} after ${waitMs / 1000} seconds` : pending(reply.service);
    return fail(`${why}. Port ${reply.port} stays published, and \`nexus preview ${reply.port} --wait\` waits for its URL`, null, 1);
  }
  if (json) {
    console.log(JSON.stringify(reply, null, 2));
    return 0;
  }
  console.log(call.command.print(reply));
  return 0;
}

process.exitCode = await main(process.argv.slice(2));
