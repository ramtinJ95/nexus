#!/usr/bin/env node
import { createHash } from "node:crypto";
import { existsSync } from "node:fs";
import { mkdir, rm } from "node:fs/promises";
import { homedir, userInfo } from "node:os";
import { join } from "node:path";
import { alive, askDecision, awaitAnswer, deliverAnswer, forgetAsk, forgetSession, hookInput, parseAskAnswer, recordCall, waitingAsks } from "./nexus-ask.ts";
import { backgroundGroups, backgroundWatch, claimHold, claudeEnviron, heartbeatDue, holdSuperseded, holdTurnEnd, releaseHold, reportedKind, reportsIntoThread } from "./nexus-heartbeat.ts";
import { answerDelivered, answerExits, claudeTurn } from "./nexus-contract.ts";
import { enqueue, startSender } from "./nexus-outbox.ts";
import { snapshotTurn } from "./nexus-turn.ts";
import { spawn } from "node:child_process";

const at = Date.now();
const asks = join(userInfo().homedir, ".nexus", "asks");

/** Reports the hook's event, and answers its session, or null when the input names none. */
async function report() {
  const payload = await hookInput(process.stdin);
  const { session_id: session } = payload ?? {};
  if (typeof session !== "string" || session.length > 200) return null;
  const answered = payload.hook_event_name === "PostToolUse" && payload.tool_name === "AskUserQuestion";
  if (answered) await forgetAsk(asks, session, payload.tool_input).catch(() => {});
  const { kind, shells } = reportedKind(process.argv[2], payload);
  // Before the event is queued, so the control plane's pull of the asks after it lists none of the session's.
  if (kind === "session.turn-started" || kind === "session.turn-ended" || kind === "session.ended") await forgetSession(asks, session).catch(() => {});
  if (shells !== undefined) {
    const groups = process.env.CLAUDE_PID === undefined ? [] : await backgroundGroups(Number(process.env.CLAUDE_PID));
    send(process.execPath, [import.meta.filename, "hold", session, String(at), groups.map((g) => `${g.pgid}@${g.start}`).join(","), ...shells]);
  }
  const dir = join(homedir(), ".nexus", "heartbeats");
  const path = join(dir, sessionFile(session));
  if (kind === "session.heartbeat") {
    await mkdir(dir, { recursive: true });
    // An answered AskUserQuestion's heartbeat skips the throttle, since only the read after it withdraws the dashboard's
    // question for it and ends the session's wait.
    if (!answered && !await heartbeatDue(path)) return session;
  } else if (kind === "session.ended") {
    await rm(path, { force: true });
  }
  // A failed write must not lose the session, which names this turn's snapshot.
  await enqueue({ kind, at, session }).catch(() => {});
  startSender();
  return session;
}

function sessionFile(session) {
  return createHash("sha256").update(session).digest("hex");
}

function send(command, args) {
  const child = spawn(command, args, { detached: true, stdio: "ignore" });
  child.on("error", () => {});
  child.unref();
}

if (process.argv[2] === "hold") {
  const [session, stamp, groups, ...shells] = process.argv.slice(3);
  const dir = join(homedir(), ".nexus", "holds");
  const owner = join(dir, sessionFile(session));
  await mkdir(dir, { recursive: true });
  if (!await claimHold(owner, Number(stamp), process.pid)) process.exit(0);
  const superseded = () => holdSuperseded(owner, Number(stamp), process.pid);
  await holdTurnEnd({
    running: backgroundWatch(session, shells, groups.split(",").filter(Boolean).map((g) => ({ pgid: Number(g.split("@")[0]), start: Number(g.split("@")[1]) }))),
    superseded,
    async report(kind, message) {
      await enqueue({ kind, at: Number(stamp), session, ...(message === undefined ? {} : { message }) }).catch(() => {});
      startSender();
    },
  });
  await releaseHold(owner, Number(stamp), process.pid);
  process.exit(0);
}
// The control plane runs these through the probe, outside any Claude: `answer` with an answer from the dashboard, and
// `asks` for the asks that wait, to which an image from before it prints nothing.
if (process.argv[2] === "answer") {
  const answer = parseAskAnswer(process.argv[3] ?? "");
  const code = answer === null ? answerExits.malformed : await deliverAnswer(asks, answer);
  if (code === answerExits.delivered) process.stdout.write(`${answerDelivered}\n`);
  process.exit(code);
}
if (process.argv[2] === "asks") {
  process.stdout.write(`${JSON.stringify(await waitingAsks(asks))}\n`);
  process.exit(0);
}
const home = userInfo().homedir;
if (!reportsIntoThread(process.env, await claudeEnviron(process.env.CLAUDE_PID), home, existsSync(join(home, ".nexus", "pylon.json")))) process.exit(0);
// AskUserQuestion's PreToolUse records the call's ID, which its PermissionRequest input lacks. The PermissionRequest
// runs while Claude's terminal dialog shows, and prints nothing unless the dashboard answers first. A dialog the
// terminal answers stays the terminal's.
if (process.argv[2] === "ask") {
  const payload = await hookInput(process.stdin).catch(() => null);
  const session = payload?.session_id;
  if (typeof session !== "string" || session.length > 200) process.exit(0);
  if (payload.hook_event_name === "PreToolUse") {
    if (typeof payload.tool_use_id === "string") await recordCall(asks, session, payload.tool_input, payload.tool_use_id).catch(() => {});
    process.exit(0);
  }
  const claude = process.env.CLAUDE_PID === undefined ? () => true : () => alive(Number(process.env.CLAUDE_PID));
  // The dialog's Notification may reach the control plane before the waiting file exists, so the file's own event makes
  // the pull that lists the ask. A heartbeat would turn the waiting session back into a running turn.
  const waiting = async () => {
    await enqueue({ kind: "session.waiting", at: Date.now(), session }).catch(() => {});
    startSender();
  };
  const answer = await awaitAnswer(asks, { session, input: payload.tool_input, pid: process.pid, at }, claude, { waiting });
  if (answer !== null) process.stdout.write(JSON.stringify(askDecision(payload.tool_input, answer)));
  process.exit(0);
}
const session = await report().catch(() => null);
// A turn whose session is unknown reports no start, so its snapshot is named for none, and the previous turn's
// snapshot cannot pass for its own.
if (process.argv[2] === "session.turn-started") await snapshotTurn("/home/user/workspace/repo", claudeTurn(session ?? "unknown", at));
