#!/bin/sh
# Claude Code waits for its command hooks, and PostToolUse runs this after every tool call, where Node's start and
# imports take tens of milliseconds to learn that the session's heartbeat is not due. So a heartbeat whose stamp,
# which nexus-claude-hook.mjs writes, is younger than its five-minute throttle (heartbeatIntervalMs) ends here.
# Everything else runs the Node hook: AskUserQuestion's PostToolUse, which skips the throttle, and any input this
# cannot read for certain.
hook="${0%/*}/nexus-claude-hook.mjs"
[ "$1" = session.heartbeat ] || exec node "$hook" "$@"
input=$(cat)
case $input in
  *AskUserQuestion*) ;;
  '{"session_id":"'*)
    session=${input#'{"session_id":"'}
    session=${session%%'"'*}
    case $session in
      ''|*[!0-9A-Za-z-]*) ;;
      *)
        stamp=$(printf '%s' "$session" | sha256sum)
        stamp="${HOME}/.nexus/heartbeats/${stamp%% *}"
        last=
        [ -f "$stamp" ] && IFS= read -r last <"$stamp"
        case $last in
          ''|*[!0-9]*) ;;
          # Now is at most a millisecond before the clock's next second, so an exit here is never a due heartbeat.
          *) [ $((($(date +%s) + 1) * 1000 - last)) -le 300000 ] && exit 0 ;;
        esac
        ;;
    esac
    ;;
esac
printf '%s\n' "$input" | exec node "$hook" "$@"
